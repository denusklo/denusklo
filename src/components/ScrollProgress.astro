---
// Section indicator fixed at the bottom centre. Sections come from [data-section] elements;
// on home it shows and hides with the nav because it sits after .nav in the DOM.
---
<div class="sp" id="scroll-progress">
  <ul class="sp-list" id="sp-list" hidden></ul>
  <button class="sp-trigger" type="button" aria-expanded="false" aria-controls="sp-list">
    <span class="sp-labels" aria-hidden="true"></span>
    <span class="sp-bar" aria-hidden="true"><span></span></span>
  </button>
  <p class="sp-live" aria-live="polite"></p>
</div>

<script>
  const root = document.getElementById('scroll-progress')!;
  const trigger = root.querySelector<HTMLButtonElement>('.sp-trigger')!;
  const list = root.querySelector<HTMLUListElement>('.sp-list')!;
  const labels = root.querySelector('.sp-labels')!;
  const bar = root.querySelector<HTMLElement>('.sp-bar span')!;
  const live = root.querySelector('.sp-live')!;
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];

  if (sections.length) {
    // Every label is stacked in one grid cell, so the box keeps the width of the longest one.
    for (const section of sections) {
      const name = section.dataset.section!;
      labels.insertAdjacentHTML('beforeend', `<span>${name}</span>`);
      list.insertAdjacentHTML('beforeend', `<li><a href="#${section.id}">${name}</a></li>`);
    }
    const labelEls = [...labels.children];
    const links = [...list.querySelectorAll('a')];
    let current = -1;
    const setActive = (index: number) => {
      labelEls[current]?.classList.remove('is-active');
      links[current]?.removeAttribute('aria-current');
      if (current !== -1) live.textContent = sections[index].dataset.section!;
      current = index;
      labelEls[index].classList.add('is-active');
      links[index].setAttribute('aria-current', 'location');
      trigger.setAttribute('aria-label', `Sections. Current: ${sections[index].dataset.section}`);
    };

    let raf = 0;
    const update = () => {
      raf = 0;
      const line = innerHeight * .35;
      let active = 0;
      const end = document.documentElement.scrollHeight - innerHeight;
      sections.forEach((section, i) => { if (section.getBoundingClientRect().top <= line) active = i; });
      // A short last section can't reach the line before the page ends.
      if (scrollY >= end - 2) active = sections.length - 1;
      if (active !== current) setActive(active);
      // Progress runs from the first section reaching the 35% line to the bottom of the page.
      const start = Math.max(0, sections[0].getBoundingClientRect().top + scrollY - line);
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, (scrollY - start) / Math.max(1, end - start)))})`;
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    update();

    const setOpen = (open: boolean, refocus = true) => {
      list.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));
      if (!open && refocus) trigger.focus();
    };
    trigger.addEventListener('click', () => setOpen(list.hidden, false));
    // Home's motion script smooth-scrolls same-page anchors to 82px below the top; case pages use scroll-margin.
    // Deferred: a native anchor jump (case pages, reduced motion) would otherwise take focus off the trigger.
    list.addEventListener('click', event => { if ((event.target as Element).closest('a')) setTimeout(() => setOpen(false)); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && !list.hidden) setOpen(false); });
    document.addEventListener('pointerdown', event => { if (!list.hidden && !root.contains(event.target as Node)) setOpen(false); });
    root.addEventListener('focusout', event => { if (!list.hidden && !root.contains(event.relatedTarget as Node)) setOpen(false, false); });
    root.classList.add('is-ready');
  }
</script>

<style is:global>
  [data-section]{scroll-margin-top:82px}
  /* Room below the foot baseline for the indicator at max scroll: its 36px height + 32px offset + 24px.
     Padding, not margin: a margin collapses out through the home foot and is lost to its min-height. */
  .baseline{padding-bottom:92px}
  .sp{position:fixed;z-index:20;left:50%;bottom:32px;transform:translateX(-50%);opacity:0;visibility:hidden;pointer-events:none;transition:opacity .4s ease,visibility .4s}
  .sp.is-ready{opacity:1;visibility:visible;pointer-events:auto}
  .nav:not(.is-visible)~.sp{opacity:0;visibility:hidden;pointer-events:none}
  .sp-trigger{position:relative;display:block;min-width:180px;height:36px;padding:0 18px;overflow:hidden;background:#1A1A20;border:1px solid #2C2C36;border-radius:3px;color:#EDEDF2;font:inherit;font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
  .sp-labels{display:grid;justify-items:center}
  .sp-labels span{grid-area:1/1;white-space:nowrap;opacity:0;transition:opacity .2s ease}
  .sp-labels span.is-active{opacity:1}
  .sp-bar{position:absolute;left:0;right:0;bottom:0;height:2px}
  .sp-bar span{display:block;height:100%;background:#4B47FF;transform:scaleX(0);transform-origin:left}
  .sp-list{position:absolute;left:0;right:0;bottom:calc(100% + 8px);margin:0;padding:6px 0;list-style:none;background:#1A1A20;border:1px solid #2C2C36;border-radius:3px}
  .sp-list a{display:block;padding:9px 18px;font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;text-align:center;white-space:nowrap;color:#A9A9C4;text-decoration:none}
  .sp-list a:hover,.sp-list a[aria-current]{color:#EDEDF2}
  .sp-trigger:focus-visible,.sp-list a:focus-visible{outline:2px solid #8A87FF;outline-offset:2px}
  .sp-live{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  @media (prefers-reduced-motion:reduce){.sp,.sp *{transition:none!important}}
</style>
