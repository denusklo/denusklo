---
// The autospinner object: a poster first, then the three.js scene fades in over it once it's near the viewport.
---
<figure class="object object-3d">
  <div class="stage" id="object-stage" tabindex="0" role="button" aria-label="Interactive model: read, solve, spin. Press to plan a new drag.">
    <img src="/portfolio/autospinner/object-poster.webp" alt="" width="1000" height="720">
    <div class="labels" aria-hidden="true"><span data-l="2"><b>03</b> SPIN<i> · the drag</i></span><span data-l="1"><b>02</b> SOLVE<i> · the plan</i></span><span data-l="0"><b>01</b> READ<i> · the board</i></span></div>
  </div>
  <figcaption><span>OBJECT · READ → SOLVE → SPIN</span><span class="hint"><span class="hint-fine">HOVER TO OPEN · CLICK TO PLAN A DRAG</span><span class="hint-touch">TAP TO PLAN A DRAG</span></span></figcaption>
</figure>

<script>
  const stage = document.getElementById('object-stage')!;
  // Load three.js only when the stage is close; on any failure the poster simply stays.
  const observer = new IntersectionObserver(([entry]) => {
    if (!entry.isIntersecting) return;
    observer.disconnect();
    import('../scripts/autospinner-object.js')
      .then(({ mount }) => mount(stage))
      .then(() => stage.classList.add('ready'))
      .catch(() => {});
  }, { rootMargin: '200px' });
  observer.observe(stage);
</script>

<style is:global>
  .object-3d .stage{position:relative;width:100%;max-width:1000px;aspect-ratio:1000/720;margin:0 auto;background:#101014;cursor:pointer;outline:none}
  .object-3d .stage:focus-visible{box-shadow:0 0 0 1px #4B47FF}
  .object-3d .stage img{display:block;width:100%;height:100%;object-fit:contain}
  .object-3d .stage canvas{position:absolute;inset:0;display:block;width:100%;height:100%;opacity:0;transition:opacity .6s ease}
  .object-3d .stage.ready canvas{opacity:1}
  .object-3d .labels{position:absolute;inset:0;pointer-events:none;font:11px ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;color:#A0A0AA}
  .object-3d .labels span{position:absolute;transform:translate(0,-50%);opacity:0;transition:opacity .3s;white-space:nowrap}
  .object-3d .stage.ready.open .labels span{opacity:1}
  .object-3d .labels b{color:#8A87FF;font-weight:500}
  .object-3d .labels i{font-style:normal}
  .object.object-3d figcaption{display:flex;justify-content:space-between;gap:16px;max-width:1000px;margin:28px auto 0}
  .object-3d .hint{color:#6E6E7A;text-align:right}
  .object-3d .hint-touch{display:none}
  @media (hover:none){.object-3d .hint-fine{display:none}.object-3d .hint-touch{display:inline}}
  @media (max-width:1199px){.object.object-3d figcaption{margin-top:clamp(16px, 3vw, 28px)}}
  @media (max-width:700px){
    .object-3d .stage{aspect-ratio:1/1.1}
    /* The full labels run past a phone's edge; keep the step names, pinned to the stage's right edge. */
    .object-3d .labels span{left:auto!important;right:0}
    .object-3d .labels i{display:none}
  }
  @media (prefers-reduced-motion:reduce){.object-3d .stage canvas{transition:none}}
</style>
