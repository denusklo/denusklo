---
import ContactCta from './ContactCta.astro';
import ScrollProgress from './ScrollProgress.astro';
import ExternalLink from './ExternalLink.astro';
import Play from './Play.astro';

// Shared case-study page body; each /projects/* page passes its own copy.
// An `object` slot replaces the static object image (autospinner's 3D stage).
const { study } = Astro.props;
---
<header class="cs-nav"><div class="cs-inner"><a class="wordmark" href="/">Den</a><nav><a class="home" href="/">← HOME</a><span>WORK / {study.name.toUpperCase()}</span><ExternalLink href="https://github.com/denusklo">GITHUB</ExternalLink></nav></div></header>
<ScrollProgress />
<main class="cs">
  <section class="cs-intro" id="overview" data-section="Overview">
    <p class="accent-label">CASE STUDY {study.number}</p>
    <h1>{study.name}</h1>
    <p class="lead">{study.what}</p>
    <p class="tags">{study.stack.map(s => s.name).join(' · ')}<span>{study.platform}</span><ExternalLink href={study.repo}>SOURCE ON GITHUB</ExternalLink></p>
  </section>
  {Astro.slots.has('object') ? <slot name="object" /> : (
    <figure class="object">
      <img src={study.object.src} alt={study.object.alt} width="868" height="175">
      <figcaption>OBJECT · {study.object.caption}</figcaption>
    </figure>
  )}
  {study.demos.map((demo, i) => (
    <figure class="demo" {...(i === 0 && { id: 'demo', 'data-section': 'Demo' })}>
      <div class="demo-frame">
        <video muted loop playsinline preload="none" poster={demo.poster} aria-label={demo.alt}><source src={demo.src} type="video/mp4"></video>
        <span class="demo-label"><Play /> {demo.label}</span>
      </div>
      <figcaption>{demo.caption}</figcaption>
    </figure>
  ))}
  <section class="cs-section" id="project" data-section="The project">
    <div class="section-head"><h2>THE PROJECT</h2></div>
    <div class="label-row"><h3 class="accent-label">WHAT IT DOES</h3><p>{study.what}</p></div>
    <div class="label-row"><h3>WHY I BUILT IT</h3><p>{study.why}</p></div>
  </section>
  <section class="cs-section" id="how-it-works" data-section="How it works">
    <div class="section-head"><h2>HOW IT WORKS</h2><span>{study.how.route}</span></div>
    <p class="how-intro">{study.how.intro}</p>
    <ol class="steps">
      {study.how.steps.map((step, i) => (
        <li><span class="accent-label">{String(i + 1).padStart(2, '0')}</span><span class:list={['where', { 'accent-label': step.accent }]}>{step.where}</span><strong>{step.title}</strong><p>{step.text}</p></li>
      ))}
    </ol>
  </section>
  <slot />
  <section class="cs-section" id="engineering" data-section="The engineering">
    <div class="section-head"><h2>THE ENGINEERING</h2></div>
    <div class="notes">
      {study.engineering.map((note, i) => (
        <article><span class="accent-label">{String(i + 1).padStart(2, '0')}</span><h3>{note.title}</h3><p>{note.text}</p></article>
      ))}
    </div>
  </section>
  <section class="cs-section" id="stack" data-section="Stack">
    <div class="section-head"><h2>STACK</h2></div>
    {study.stack.map(s => <div class="label-row stack-row"><h3>{s.name}</h3><p>{s.text}</p></div>)}
  </section>
</main>
<footer class="cs-foot" id="next" data-section="Next case study">
  <div class="cs-inner">
    <p class="small-label">NEXT CASE STUDY</p>
    <a class="next" href={study.next.href}>{study.next.name} <span aria-hidden="true">→</span></a>
    <div class="foot-cols">
      <div><p class="small-label">CONTACT</p><a class="email" href="mailto:denusklo@gmail.com">denusklo@gmail.com</a><ContactCta /></div>
      <div><p class="small-label">CODE</p><ExternalLink class="quiet" href="https://github.com/denusklo">github.com/denusklo</ExternalLink></div>
      <div><p class="small-label">BACK</p><a class="quiet" href="/">← Home</a><p class="quiet">All work, the band and the colophon live on the home page.</p></div>
    </div>
    <div class="baseline"><span>DEN · 2026<a href="/v1">PREVIOUS SITE →</a></span><span>CASE STUDY {study.number} / 02</span></div>
  </div>
</footer>

<script>
  // Demos play muted and looped while at least half in view; reduced motion keeps the posters.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(entries => {
      for (const { target, isIntersecting } of entries) {
        const video = target as HTMLVideoElement;
        if (isIntersecting) video.play().catch(() => {});
        else video.pause();
      }
    }, { threshold: .5 });
    document.querySelectorAll('.demo video').forEach(video => observer.observe(video));
  }
</script>

<style is:global>
  *{box-sizing:border-box}
  html{background:#101014}
  @media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
  body{margin:0;min-width:1440px;background:#101014;color:#EDEDF2;font-family:Inter,Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:inherit}
  .cs-inner,.cs{width:1200px;margin:0 auto}
  .cs-nav{position:sticky;top:0;z-index:10;height:82px;background:#101014;border-bottom:1px solid #2C2C36}
  .cs-inner{height:100%}
  .cs-nav .cs-inner{display:flex;align-items:center;justify-content:space-between}
  .wordmark{font-size:16px;font-weight:650;text-decoration:none}
  .cs-nav nav{display:flex;gap:32px;font-size:10px;letter-spacing:.13em;color:#A0A0AA}
  .cs-nav nav a{text-decoration:none}
  .cs-nav nav a:hover,.cs-nav .home{color:#EDEDF2}
  .cs-nav .home{font-weight:650}
  .accent-label{color:#8A87FF!important}
  .cs-intro{padding-top:120px}
  .cs-intro .accent-label{font-size:11px;letter-spacing:.1em;font-weight:600;margin:0}
  .cs-intro h1{font-size:108px;line-height:1;letter-spacing:-.035em;font-weight:600;margin:22px 0 30px}
  .lead{max-width:830px;font-size:24px;line-height:1.5;color:#B4B4C0;margin:0}
  .tags{font-size:10px;letter-spacing:.13em;color:#A0A0AA;margin:34px 0 0;word-spacing:.3em}
  .tags>span{margin-left:36px}
  .tags a{margin-left:36px;text-decoration:none;color:#EDEDF2}
  .tags a:hover{text-decoration:underline}
  .tags a:focus-visible{outline:1px solid #8A87FF;outline-offset:3px}
  .object{margin:110px 0 0}
  .object img{display:block;width:868px;height:auto;margin:0 auto}
  figcaption{font-size:10px;letter-spacing:.12em;color:#A0A0AA}
  .object figcaption{margin-top:70px}
  .demo{margin:90px 0 0}
  .demo+.demo{margin-top:56px}
  .demo-frame{position:relative;width:1200px;height:675px;background:#1A1A20;overflow:hidden}
  .demo video{display:block;width:100%;height:100%;object-fit:cover}
  .demo-label{position:absolute;top:16px;left:17px;font-size:10px;letter-spacing:.1em;color:#EDEDF2;text-shadow:0 1px 8px #101014,0 1px 5px #101014}
  .demo figcaption{max-width:870px;margin-top:18px;font-size:13px;line-height:1.6;letter-spacing:0}
  .cs-section{padding-top:150px}
  .section-head{height:32px;display:flex;align-items:flex-start;justify-content:space-between;border-bottom:1px solid #2C2C36}
  .section-head h2{font-size:11px;letter-spacing:.1em;margin:0;font-weight:650}
  .section-head span{font-size:10px;letter-spacing:.13em;color:#A0A0AA}
  .label-row{display:grid;grid-template-columns:220px 1fr;padding:26px 0;border-bottom:1px solid #2C2C36}
  .label-row h3{font-size:10px;letter-spacing:.12em;font-weight:600;color:#A0A0AA;margin:8px 0 0}
  .label-row p{font-size:22px;line-height:1.55;margin:0}
  .how-intro{max-width:870px;font-size:20px;line-height:1.55;margin:44px 0 28px}
  .steps{list-style:none;margin:0;padding:0}
  .steps li{display:grid;grid-template-columns:60px 160px 260px 1fr;padding:18px 0;border-top:1px solid #2C2C36}
  .steps li span{font-size:10px;letter-spacing:.12em;font-weight:600;padding-top:6px}
  .steps strong{font-size:17px;font-weight:600}
  .steps p{margin:0;font-size:15px;line-height:1.6;color:#A0A0AA}
  .notes{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;padding-top:36px}
  .notes span{font-size:10px;letter-spacing:.12em;font-weight:600}
  .notes h3{font-size:22px;font-weight:600;letter-spacing:-.01em;margin:14px 0 16px}
  .notes p{font-size:15px;line-height:1.66;color:#A0A0AA;margin:0}
  .stack-row{padding:34px 0 26px}
  .stack-row h3{color:#EDEDF2}
  .stack-row p{font-size:18px}
  .cs-foot{margin-top:120px;border-top:1px solid #2C2C36;padding-top:94px}
  .small-label{font-size:10px;letter-spacing:.13em;color:#A0A0AA;margin:0}
  .next{display:inline-block;margin:14px 0 76px;font-size:64px;font-weight:600;letter-spacing:-.03em;text-decoration:none}
  .next span{margin-left:18px}
  .foot-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:36px}
  .foot-cols .small-label{margin-bottom:14px}
  .email{display:block;font-size:18px;font-weight:600;text-decoration:none}
  .quiet{font-size:14px;line-height:1.6;color:#A9A9C4;text-decoration:none;margin:0}
  a.quiet{display:inline-block;margin-bottom:8px}
  .quiet:hover,.next:hover{color:#EDEDF2}
  .foot-cols .cta{margin-top:14px}
  .baseline a{margin-left:24px;text-decoration:none}
  .baseline a:hover{color:#EDEDF2}
  .baseline a:focus-visible{outline:1px solid #8A87FF;outline-offset:3px}
  .baseline{margin-top:56px;padding-top:23px;border-top:1px solid #2C2C36;display:flex;justify-content:space-between;color:#A9A9C4;font-size:10px;letter-spacing:.12em}
  /* Tablet and phone: same sections, fluid width, type sized with clamp(). Desktop above is untouched. */
  @media (max-width:1199px){
    body{min-width:0;overflow-x:clip}
    .cs-inner,.cs{width:calc(100% - 2 * var(--gutter))}
    .cs-nav{height:calc(82px + env(safe-area-inset-top));padding-top:env(safe-area-inset-top)}
    .cs-nav nav{gap:clamp(16px, 3vw, 32px)}
    .cs-intro{padding-top:clamp(56px, 9vw, 120px)}
    .cs-intro h1{font-size:clamp(44px, 8.6vw, 108px);overflow-wrap:anywhere}
    .lead{font-size:clamp(18px, 2.1vw, 24px)}
    .tags{line-height:2}
    .tags>span{margin-left:0;display:inline-block;padding-left:clamp(12px, 3vw, 36px)}
    .tags a{margin-left:0;display:inline-block;padding-left:clamp(12px, 3vw, 36px)}
    .object{margin-top:clamp(48px, 8vw, 110px)}
    .object img{width:min(868px, 100%)}
    .object figcaption{margin-top:clamp(28px, 5vw, 70px)}
    .demo{margin-top:clamp(48px, 7vw, 90px)}
    .demo+.demo{margin-top:clamp(32px, 4vw, 56px)}
    .demo-frame{width:100%;height:auto;aspect-ratio:16/9}
    .cs-section{padding-top:clamp(80px, 11vw, 150px)}
    .section-head{height:auto;min-height:32px;flex-wrap:wrap;column-gap:16px;row-gap:6px}
    .label-row{grid-template-columns:clamp(140px, 18vw, 220px) 1fr;column-gap:16px}
    .label-row p{font-size:clamp(17px, 2vw, 22px)}
    .how-intro{font-size:clamp(17px, 1.9vw, 20px);margin:clamp(28px, 4vw, 44px) 0 clamp(20px, 2.5vw, 28px)}
    .steps li{grid-template-columns:44px 100px minmax(150px, 220px) 1fr;column-gap:12px}
    .notes{gap:clamp(24px, 3vw, 36px)}
    .stack-row p{font-size:clamp(16px, 1.7vw, 18px)}
    .cs-foot{margin-top:clamp(72px, 10vw, 120px);padding-top:clamp(56px, 8vw, 94px)}
    .next{font-size:clamp(36px, 6vw, 64px);margin-bottom:clamp(40px, 6vw, 76px);overflow-wrap:anywhere}
    .foot-cols{grid-template-columns:1fr 1fr;gap:32px 24px}
    .baseline{flex-wrap:wrap;gap:8px 24px}
  }
  @media (max-width:767px){
    /* The breadcrumb repeats the page title; phones keep HOME and GITHUB. */
    .cs-nav nav span{display:none}
    .label-row{grid-template-columns:1fr;row-gap:10px}
    .label-row h3{margin:0}
    .steps li{grid-template-columns:40px 1fr;row-gap:6px;padding:16px 0}
    .steps li strong,.steps li p{grid-column:1 / -1}
    .notes{grid-template-columns:1fr}
    .foot-cols{grid-template-columns:1fr}
  }
</style>
